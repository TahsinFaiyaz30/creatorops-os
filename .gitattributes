# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source/config files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat images as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

# Treat fonts as binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Treat archives as binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Treat PDFs as binary
*.pdf binary